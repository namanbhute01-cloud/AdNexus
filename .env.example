# ---------------------------------------------------------------------------
# Copy to apps/web/.env.local (app) and packages/database/.env (Prisma CLI).
# DATABASE_URL must be identical in both.
# Values below are placeholders or development defaults. Never commit real
# secrets.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/vaarte?schema=public"

# --- Auth (required) -------------------------------------------------------
# Signs JWT session cookies. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Canonical origin, used for auth callbacks. Must match the address students
# reach, not localhost.
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Base URL handed to TVs. Set to the machine's LAN IP when handing player URLs
# to real devices.
NEXT_PUBLIC_PLAYER_BASE_URL=""

# --- Admin bootstrap (production only) -------------------------------------
# In production the seed creates NO default accounts. It uses these instead and
# refuses passwords shorter than 12 characters. Run:
#   ADMIN_EMAIL=... ADMIN_PASSWORD=... npx prisma db seed
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ===========================================================================
# Community Gallery
# ===========================================================================

# Signs the 6-hour upload tokens shown to anonymous contributors.
# Required. Generate: openssl rand -hex 32
GALLERY_TOKEN_SECRET=""

# HMAC key used to hash visitor IPs. Raw IPs are never stored.
# Required. Generate: openssl rand -hex 32
GALLERY_IP_SALT=""

# The origin printed in the QR code. Must be reachable from students' phones.
# Required. Example: https://gallery.yourdomain.com
PUBLIC_BASE_URL=""

# Set to true ONLY when the app is reachable exclusively through Cloudflare
# (Tunnel or reverse proxy). It enables trusting the cf-connecting-ip header,
# which is trivially spoofable if the origin is directly reachable.
TRUST_CF_HEADER=""

# Optional. Where unapproved submissions are quarantined.
# Defaults to apps/web/.data/gallery — never put this inside public/.
GALLERY_PRIVATE_DIR=""

# --- Cloudflare R2 (optional) ---------------------------------------------
# Without all four set (and not "dummy"), uploads fall back to local disk.
# Approved gallery media is then served by /media/... instead of an R2 URL.
R2_ACCOUNT_ID="dummy"
R2_ACCESS_KEY_ID="dummy"
R2_SECRET_ACCESS_KEY="dummy"
R2_BUCKET_NAME="dummy"
R2_PUBLIC_URL="dummy"

# --- Pusher (optional) -----------------------------------------------------
# Without Pusher, screens pick up approved photos on the 15s poll instead.
# PUSHER_APP_ID="dummy"
# PUSHER_KEY="dummy"
# PUSHER_SECRET="dummy"
# PUSHER_CLUSTER="mt1"
# NEXT_PUBLIC_PUSHER_KEY=""
# NEXT_PUBLIC_PUSHER_CLUSTER="mt1"